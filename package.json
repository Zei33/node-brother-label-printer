{
  "name": "node-brother-label-printer",
  "version": "2.0.0",
  "description": "This Node.js package offers a straightforward interface for Brother label printers, utilizing the raster command system for binary bitmap data handling.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
	"src/",
    "config/",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --project tsconfig.cjs.json && npm run fix-cjs-extensions",
    "fix-cjs-extensions": "node scripts/fix-cjs-extensions.js",
    "clean": "rimraf dist dist-cjs",
    "dev": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zei33/node-brother-label-printer.git"
  },
  "keywords": [
    "node-brother-label-printer"
  ],
  "author": "Zei33",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zei33/node-brother-label-printer/issues"
  },
  "homepage": "https://github.com/zei33/node-brother-label-printer#readme",
  "dependencies": {
    "pngparse": "^2.0.1",
    "sharp": "^0.33.4",
    "usb": "^2.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "eslint-config-love": "^122.0.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
